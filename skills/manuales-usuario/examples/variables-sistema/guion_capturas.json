  "_nota": "Guion del ejemplo. Selectores tomados del código del front (topbar, variables-sistema.component.html). La ruta /variables-sistema y la etiqueta del menú se confirman en la exploración (Fase 3) antes de correrlo.",
  "base_url": "http://localhost:4200",
