APP_DOMAIN=plane.casmart.internal
APP_RELEASE=v1.3.1

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

LISTEN_HTTP_PORT=8081
LISTEN_HTTPS_PORT=8443

WEB_URL=https://${APP_DOMAIN}
DEBUG=0
CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN}
API_BASE_URL=http://api:8000

# DB SETTINGS (Redirected to remote database 10.4.3.23)
PGHOST=10.4.3.23
PGDATABASE=plane_db
POSTGRES_USER=plane_user
POSTGRES_PASSWORD=plane_secure_password_2026
POSTGRES_DB=plane_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane_user:plane_secure_password_2026@10.4.3.23:5432/plane_db

# REDIS SETTINGS
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:plane@plane-mq:5672/plane

# Storage
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Proxy Cert Settings
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
SITE_ADDRESS=plane.casmart.internal

# Gitea OAuth via Authentik (rutas Gitea están en el bloque HTTPS de Caddy)
GITEA_HOST=https://plane.casmart.internal
GITEA_CLIENT_ID=plane
GITEA_CLIENT_SECRET=casmarts_secret_2026

SECRET_KEY=60gp0byfz2dvffa45cxl20p1scy9xbpf6d8c5y0geejgkyp1b5
LIVE_SERVER_SECRET_KEY=2FiJk1U2aiVPEQtzLehYGlTSnTnrs7LW

# Authentik OAuth Configuration
AUTHENTIK_CLIENT_ID=plane_client_id_2026
