kiwi.casmart.internal {
    tls internal
    reverse_proxy https://kiwi-tcms:8443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

plane.casmart.internal {
    tls internal

    # Puente Gitea OAuth → Authentik.
    # Estas rutas son usadas por el browser (redirect) y por el API server de Plane (token/userinfo).
    handle /login/oauth/authorize {
        redir https://auth.casmart.internal/application/o/authorize/?{query} 302
    }

    handle /login/oauth/access_token {
        rewrite * /application/o/token/
        reverse_proxy https://10.4.3.208 {
            transport http {
                tls_insecure_skip_verify
            }
            header_up Host auth.casmart.internal
        }
    }

    handle /api/v1/user {
        reverse_proxy gitea-bridge:5000
    }

    redir /spaces /spaces/ permanent
    reverse_proxy /spaces/* space:3000

    redir /god-mode /god-mode/ permanent
    reverse_proxy /god-mode/* admin:3000

    reverse_proxy /live/* live:3000
    reverse_proxy /api/* api:8000
    reverse_proxy /auth/* api:8000
    reverse_proxy /static/* api:8000

    reverse_proxy /uploads/* plane-minio:9000
    reverse_proxy /uploads plane-minio:9000

    reverse_proxy /* web:3000
}
